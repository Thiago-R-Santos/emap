# Obtenha sua chave gratuita em: https://the-odds-api.com/
ODDS_API_KEY=sua_chave_aqui

# Intervalo de atualização em segundos (padrão: 30)
REFRESH_INTERVAL=30

# Lucro mínimo para exibir arbitragem (%) (padrão: 0.5)
MIN_PROFIT_PCT=0.5

# Capital total para calcular stakes (R$) (padrão: 1000)
TOTAL_STAKE=1000

# Usar dados simulados quando sem chave de API (true/false)
USE_MOCK=false

# Ativar scrapers Playwright para Betano, Sportingbet, Superbet (contorna Cloudflare)
# Requer: pip install playwright && playwright install chromium
USE_PLAYWRIGHT=false
